# dependencies
node_modules/
.pnp
.pnp.js

# next.js
web/.next/
web/out/

# production
web/build/

# env
.env
.env.local
.env*.local

# testing / coverage
web/coverage/

# misc
.DS_Store
*.pem
npm-debug.log*

# flutter
mobile/.dart_tool/
mobile/.packages
mobile/build/
# generati da drift_dev/riverpod_generator (dart run build_runner build):
# vanno rigenerati in locale/CI, non committati, per evitare che sorgente e
# codice generato divergano.
mobile/**/*.g.dart
# file locali con i valori --dart-define (vedi mobile/README.md), contengono
# chiavi/id di configurazione: mai committare.
mobile/*.local.json
# generato da 'flutter gen-l10n' (o automaticamente da flutter pub get/build)
# a partire da mobile/lib/l10n/*.arb: non committato, stesso motivo dei .g.dart.
mobile/lib/l10n/generated/

# supabase CLI cache locale
supabase/.temp/
.fuse_hidden*
